generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  CLIENT
}

enum VehicleStatus {
  EN_VENTE
  VENDU
  RETIRE
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  role                 Role
  // Jeton d'activation : permet au client de définir lui-même son mot de
  // passe via /activate/[token] au lieu de recevoir un mot de passe généré
  // en clair. Effacé une fois le compte activé.
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?
  client               Client?
  createdAt            DateTime  @default(now())
}

model Client {
  id                String          @id @default(cuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String
  phone             String?
  vehicles          Vehicle[]
  notifications     Notification[]
  priceProposals    PriceProposal[]
  // Dernière fois qu'un avis Google lui a été demandé (voir /staff/reviews).
  reviewRequestedAt DateTime?
  createdAt         DateTime        @default(now())
}

model Vehicle {
  id             String          @id @default(cuid())
  clientId       String
  client         Client          @relation(fields: [clientId], references: [id])
  make           String
  model          String
  year           Int
  mileage        Int
  fuelType       String
  reference      String          @unique
  price          Int
  status         VehicleStatus   @default(EN_VENTE)
  depositDate    DateTime
  listingUrls    ListingUrl[]
  photos         Photo[]
  weeklyStats    WeeklyStat[]
  notifications  Notification[]
  priceProposals PriceProposal[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([clientId])
}

model ListingUrl {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  label     String
  url       String

  @@index([vehicleId])
}

model Photo {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)

  @@index([vehicleId])
}

model WeeklyStat {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  weekStart DateTime
  views     Int      @default(0)
  contacts  Int      @default(0)
  calls     Int      @default(0)
  favorites Int      @default(0)
  visits    Int      @default(0)
  offers    Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, weekStart])
  @@index([vehicleId])
}

// Ligne unique de réglages globaux pour l'agence (id fixe "settings").
model Settings {
  id              String  @id @default("settings")
  googleReviewUrl String?
}

enum NotificationType {
  STAT
  REVIEW
  PRICE_PROPOSAL
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Proposition d'ajustement de prix soumise par un client, à valider par le staff.
model PriceProposal {
  id            String         @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposedPrice Int
  message       String?
  status        ProposalStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  respondedAt   DateTime?

  @@index([vehicleId])
  @@index([clientId])
}

model Notification {
  id        String           @id @default(cuid())
  clientId  String
  client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Absent pour les notifications qui ne concernent pas un véhicule précis (ex. demande d'avis Google).
  vehicleId String?
  vehicle   Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type      NotificationType @default(STAT)
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([clientId])
  @@index([vehicleId])
}
