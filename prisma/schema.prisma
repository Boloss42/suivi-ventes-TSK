generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  CLIENT
  SUPER_ADMIN
}

enum VehicleStatus {
  EN_VENTE
  VENDU
  RETIRE
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  role                 Role
  // Renseignés par l'agent lui-même (page "Mon profil") : affichés à ses
  // clients ("Votre conseillé") pour identifier et joindre leur commercial.
  firstName            String?
  phone                String?
  // Jeton d'activation : permet au client de définir lui-même son mot de
  // passe via /activate/[token] au lieu de recevoir un mot de passe généré
  // en clair. Effacé une fois le compte activé.
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?
  client               Client?   @relation("ClientAccount")
  // Clients dont cet agent (STAFF) est le commercial attribué.
  assignedClients      Client[]  @relation("AssignedStaff")
  // Non défini pour SUPER_ADMIN et CLIENT ; obligatoire en pratique pour STAFF
  // (validé côté application, comme clientId ci-dessus).
  agencyId             String?
  agency               Agency?   @relation(fields: [agencyId], references: [id])
  createdAt            DateTime  @default(now())

  @@index([agencyId])
}

// Une agence de la franchise. Le super-admin fixe combien de comptes agents
// (STAFF) elle peut avoir ; les agents ne voient jamais les données d'une
// autre agence.
model Agency {
  id               String   @id @default(cuid())
  name             String
  maxStaffAccounts Int      @default(1)
  googleReviewUrl  String?
  createdAt        DateTime @default(now())

  staff    User[]
  clients  Client[]
  vehicles Vehicle[]
}

model Client {
  id                String          @id @default(cuid())
  userId            String          @unique
  user              User            @relation("ClientAccount", fields: [userId], references: [id], onDelete: Cascade)
  agencyId          String
  agency            Agency          @relation(fields: [agencyId], references: [id])
  // Agent (STAFF) commercial de ce client, attribué automatiquement à la
  // création (le créateur). Devient null si cet agent est supprimé — le
  // client n'est alors visible d'aucun agent tant que le super-admin ne l'a
  // pas réattribué (espace admin, fiche agence).
  assignedStaffId   String?
  assignedStaff     User?           @relation("AssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  firstName         String
  lastName          String
  phone             String?
  vehicles          Vehicle[]
  notifications     Notification[]
  priceProposals    PriceProposal[]
  // Dernière fois qu'un avis Google lui a été demandé (voir /staff/reviews).
  reviewRequestedAt DateTime?
  createdAt         DateTime        @default(now())

  @@index([agencyId])
  @@index([assignedStaffId])
}

model Vehicle {
  id             String          @id @default(cuid())
  clientId       String
  client         Client          @relation(fields: [clientId], references: [id])
  // Dénormalisé depuis Client.agencyId pour éviter une jointure sur chaque
  // requête de l'espace staff.
  agencyId       String
  agency         Agency          @relation(fields: [agencyId], references: [id])
  make           String
  model          String
  year           Int
  mileage        Int
  fuelType       String
  // Unique par agence, pas globalement : deux agences indépendantes peuvent
  // légitimement réutiliser une même référence interne.
  reference      String
  price          Int
  // Prix de conseil de l'agent (prix auquel il estime que le véhicule devrait
  // se vendre) : facultatif, affiché au client comme repère.
  advisedPrice   Int?
  status         VehicleStatus   @default(EN_VENTE)
  depositDate    DateTime
  // Jeton du lien de partage public (/a/<token>), généré à la demande.
  shareToken     String?         @unique
  listingUrls    ListingUrl[]
  photos         Photo[]
  weeklyStats    WeeklyStat[]
  notifications  Notification[]
  priceProposals PriceProposal[]
  priceChanges   PriceChange[]
  shareClicks    ShareClick[]
  offers         Offer[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([agencyId, reference])
  @@index([clientId])
  @@index([agencyId])
}

// Historique des prix nets vendeur d'un véhicule (une entrée par changement).
model PriceChange {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  price     Int
  createdAt DateTime @default(now())

  @@index([vehicleId])
}

// Un clic sur le lien de partage public d'un véhicule.
model ShareClick {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model ListingUrl {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  label     String
  url       String

  @@index([vehicleId])
}

model Photo {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)

  @@index([vehicleId])
}

model WeeklyStat {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  weekStart DateTime
  views     Int      @default(0)
  contacts  Int      @default(0)
  calls     Int      @default(0)
  favorites Int      @default(0)
  visits    Int      @default(0)
  offers    Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, weekStart])
  @@index([vehicleId])
}

// Offre d'achat reçue pour un véhicule, saisie par l'agent. Le contact de
// l'acheteur (buyerContact) reste réservé à l'agent : la vue client n'expose
// que le montant, le statut et le nom de l'acheteur.
model Offer {
  id           String      @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  amount       Int
  buyerName    String?
  buyerContact String?
  note         String?
  status       OfferStatus @default(NEW)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([vehicleId])
}

enum OfferStatus {
  NEW
  COUNTERED
  ACCEPTED
  REJECTED
}

enum NotificationType {
  STAT
  REVIEW
  PRICE_PROPOSAL
  OFFER
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Proposition d'ajustement de prix soumise par un client, à valider par le staff.
model PriceProposal {
  id            String         @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposedPrice Int
  message       String?
  status        ProposalStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  respondedAt   DateTime?

  @@index([vehicleId])
  @@index([clientId])
}

model Notification {
  id        String           @id @default(cuid())
  clientId  String
  client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Absent pour les notifications qui ne concernent pas un véhicule précis (ex. demande d'avis Google).
  vehicleId String?
  vehicle   Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type      NotificationType @default(STAT)
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([clientId])
  @@index([vehicleId])
}
