# Base de données PostgreSQL. En local, le plus simple est un projet gratuit
# sur neon.tech ou supabase.com (aucune installation requise) ; une instance
# Postgres locale (Postgres.app, Docker...) fonctionne aussi.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret utilisé par Auth.js pour signer les sessions.
# Générer une valeur avec : openssl rand -base64 32
AUTH_SECRET="change-me"

# Stockage des photos de véhicules — Cloudflare R2 (compatible S3).
# Bucket privé au niveau des clés ; R2_PUBLIC_URL est le sous-domaine public
# r2.dev (ou un domaine perso) servant les photos d'annonces.
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
R2_ACCOUNT_ID="votre-account-id"
R2_ACCESS_KEY_ID="votre-access-key-id"
R2_SECRET_ACCESS_KEY="votre-secret-access-key"
R2_BUCKET_NAME="myvitrine-photos"

# Emails transactionnels — Resend (https://resend.com).
# RESEND_API_KEY : clé API (re_...). Sans elle, les emails sont ignorés (no-op).
# EMAIL_FROM : expéditeur ; en test "MyVitrine <onboarding@resend.dev>",
# en prod une adresse d'un domaine vérifié dans Resend.
RESEND_API_KEY=""
EMAIL_FROM="MyVitrine <onboarding@resend.dev>"
