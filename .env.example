# Base de données PostgreSQL. En local, le plus simple est un projet gratuit
# sur neon.tech ou supabase.com (aucune installation requise) ; une instance
# Postgres locale (Postgres.app, Docker...) fonctionne aussi.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret utilisé par Auth.js pour signer les sessions.
# Générer une valeur avec : openssl rand -base64 32
AUTH_SECRET="change-me"
